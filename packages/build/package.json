{
  "name": "@darrylondil/lorien-build",
  "version": "0.2.0",
  "description": "Compiler and CLI for lorien projects: lorien build (codegen), lorien dev (interpreter), lorien init, lorien import-openapi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darrylhuffman/lorien.git",
    "directory": "packages/build"
  },
  "homepage": "https://github.com/darrylhuffman/lorien#readme",
  "bugs": "https://github.com/darrylhuffman/lorien/issues",
  "author": "dyudabomb@gmail.com",
  "keywords": [
    "lorien",
    "cli",
    "build",
    "codegen",
    "hono",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./run-build": {
      "types": "./dist/run-build.d.ts",
      "default": "./dist/run-build.js"
    }
  },
  "bin": {
    "lorien": "./bin/lorien.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@darrylondil/lorien-ide": "workspace:*",
    "@darrylondil/lorien-openapi": "workspace:*",
    "@darrylondil/lorien-runtime": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "create-lorien": "workspace:*",
    "esbuild": "^0.27.7",
    "hono": "^4.12.21",
    "typescript": "^6.0.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  }
}
