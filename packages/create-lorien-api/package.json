{
  "name": "create-lorien",
  "version": "0.2.1",
  "description": "Scaffold a new lorien project \u2014 npx create-lorien <name>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darrylhuffman/lorien.git",
    "directory": "packages/create-lorien-api"
  },
  "homepage": "https://github.com/darrylhuffman/lorien#readme",
  "bugs": "https://github.com/darrylhuffman/lorien/issues",
  "author": "dyudabomb@gmail.com",
  "keywords": [
    "lorien",
    "scaffold",
    "create-app",
    "starter",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "create-lorien": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js",
    "./templates": {
      "types": "./dist/templates.d.ts",
      "default": "./dist/templates.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.7"
  }
}
