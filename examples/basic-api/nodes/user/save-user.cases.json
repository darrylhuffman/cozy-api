{
  "lorien": 1,
  "cases": [
    {
      "id": "savesAUser",
      "name": "Saves a user with the configured database",
      "input": { "email": "ada@example.com", "password": "correct-horse" },
      "expect": { "output": { "user": { "email": "ada@example.com" } } }
    },
    {
      "id": "returnsTheStoredRecord",
      "name": "Returns what the database stored",
      "input": { "email": "ada@example.com", "password": "correct-horse" },
      "mocks": {
        "db": { "createUser": { "returns": { "id": "u_1", "email": "ada@example.com" } } }
      },
      "expect": {
        "output": { "user": { "id": "u_1", "email": "ada@example.com" } },
        "match": "equals"
      }
    },
    {
      "id": "rejectsAShortPassword",
      "name": "Rejects a password under 6 characters",
      "input": { "email": "ada@example.com", "password": "123" },
      "expect": { "error": "password" }
    },
    {
      "id": "surfacesDatabaseErrors",
      "name": "Surfaces database errors",
      "input": { "email": "ada@example.com", "password": "correct-horse" },
      "mocks": { "db": { "createUser": { "throws": "connection refused" } } },
      "expect": { "error": "connection refused" }
    }
  ]
}
