{
  "lorien": 1,
  "requests": [
    {
      "id": "addsASoldPet",
      "name": "Adds a sold pet",
      "method": "POST",
      "path": "/pets",
      "body": {
        "kind": "json",
        "json": {
          "name": "{{petPrefix}}-{{$randomInt}}",
          "species": "goldfish",
          "status": "sold"
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 201
        }
      ],
      "capture": {
        "petId": "body.id"
      }
    },
    {
      "id": "countsPetsByStatus",
      "name": "Counts pets by status",
      "trigger": "Request",
      "method": "GET",
      "path": "/store/inventory",
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 200
        },
        {
          "target": "body",
          "path": "available",
          "op": "type",
          "value": "number"
        },
        {
          "target": "body",
          "path": "pending",
          "op": "type",
          "value": "number"
        },
        {
          "target": "body",
          "path": "sold",
          "op": "greaterThan",
          "value": 0
        }
      ]
    },
    {
      "id": "returnsTheCountsGetInventoryReports",
      "name": "Returns the counts GetInventory reports",
      "trigger": "Request",
      "method": "GET",
      "path": "/store/inventory",
      "mocks": {
        "GetInventory": {
          "output": {
            "inventory": {
              "available": 3,
              "pending": 1,
              "sold": 2
            }
          }
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 200
        },
        {
          "target": "body",
          "op": "equals",
          "value": {
            "available": 3,
            "pending": 1,
            "sold": 2
          }
        }
      ]
    }
  ]
}
