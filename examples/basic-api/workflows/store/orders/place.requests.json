{
  "lorien": 1,
  "requests": [
    {
      "id": "addsAPetToOrder",
      "name": "Adds a pet to order",
      "method": "POST",
      "path": "/pets",
      "body": {
        "kind": "json",
        "json": {
          "name": "{{petPrefix}}-{{$randomInt}}",
          "species": "cat"
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 201
        }
      ],
      "capture": {
        "petId": "body.id"
      }
    },
    {
      "id": "placesAnOrder",
      "name": "Places an order, one pet by default",
      "trigger": "Request",
      "method": "POST",
      "path": "/store/orders",
      "body": {
        "kind": "json",
        "json": {
          "petId": "{{petId}}"
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 201
        },
        {
          "target": "body",
          "path": "status",
          "op": "equals",
          "value": "placed"
        },
        {
          "target": "body",
          "path": "quantity",
          "op": "equals",
          "value": 1
        }
      ]
    },
    {
      "id": "refusesThePetOnceOrdered",
      "name": "Refuses the same pet again",
      "trigger": "Request",
      "method": "POST",
      "path": "/store/orders",
      "body": {
        "kind": "json",
        "json": {
          "petId": "{{petId}}"
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 409
        }
      ]
    },
    {
      "id": "returns404ForAnUnknownPet",
      "name": "Returns 404 for a pet that does not exist",
      "trigger": "Request",
      "method": "POST",
      "path": "/store/orders",
      "body": {
        "kind": "json",
        "json": {
          "petId": 99999999
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 404
        }
      ]
    },
    {
      "id": "rejectsAZeroQuantity",
      "name": "Rejects a quantity under 1",
      "trigger": "Request",
      "method": "POST",
      "path": "/store/orders",
      "body": {
        "kind": "json",
        "json": {
          "petId": 1,
          "quantity": 0
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "greaterThan",
          "value": 399
        }
      ]
    }
  ]
}
