{
  "lorien": 1,
  "requests": [
    {
      "id": "addsAPet",
      "name": "Adds a pet",
      "trigger": "Request",
      "method": "POST",
      "path": "/pets",
      "body": {
        "kind": "json",
        "json": {
          "name": "{{petPrefix}}-{{$randomInt}}",
          "species": "dog"
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 201
        },
        {
          "target": "body",
          "path": "id",
          "op": "type",
          "value": "number"
        },
        {
          "target": "body",
          "path": "status",
          "op": "equals",
          "value": "available"
        },
        {
          "target": "node",
          "node": "AddPet",
          "path": "input.species",
          "op": "equals",
          "value": "dog"
        },
        {
          "target": "node",
          "node": "AddPet",
          "path": "output.pet.id",
          "op": "type",
          "value": "number"
        }
      ],
      "capture": {
        "petId": "body.id"
      }
    },
    {
      "id": "rejectsAMissingSpecies",
      "name": "Rejects a pet without a species",
      "trigger": "Request",
      "method": "POST",
      "path": "/pets",
      "body": {
        "kind": "json",
        "json": {
          "name": "Nameless"
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "greaterThan",
          "value": 399
        },
        {
          "target": "node",
          "node": "AddPet",
          "op": "notExists"
        }
      ]
    },
    {
      "id": "reportsADatabaseFailure",
      "name": "Reports a database failure as a 500",
      "trigger": "Request",
      "method": "POST",
      "path": "/pets",
      "body": {
        "kind": "json",
        "json": {
          "name": "Rex",
          "species": "dog"
        }
      },
      "mocks": {
        "AddPet": {
          "error": "database is locked"
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 500
        },
        {
          "target": "body",
          "path": "error",
          "op": "contains",
          "value": "database is locked"
        },
        {
          "target": "node",
          "node": "Response",
          "op": "notExists"
        }
      ]
    }
  ]
}
