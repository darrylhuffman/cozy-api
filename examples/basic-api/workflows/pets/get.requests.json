{
  "lorien": 1,
  "requests": [
    {
      "id": "findsAPet",
      "name": "Finds a pet by id",
      "trigger": "Request",
      "method": "GET",
      "path": "/pets/1",
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 200
        },
        {
          "target": "body",
          "path": "name",
          "op": "equals",
          "value": "Biscuit"
        }
      ]
    },
    {
      "id": "returns404ForAMissingPet",
      "name": "Returns 404 for a missing pet",
      "trigger": "Request",
      "method": "GET",
      "path": "/pets/99999",
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 404
        },
        {
          "target": "body",
          "path": "error",
          "op": "contains",
          "value": "not found"
        },
        {
          "target": "node",
          "node": "FindPet",
          "path": "output.status",
          "op": "equals",
          "value": 404
        }
      ]
    },
    {
      "id": "addsAPetToFind",
      "name": "Adds a pet to find",
      "method": "POST",
      "path": "/pets",
      "body": {
        "kind": "json",
        "json": {
          "name": "{{petPrefix}}-{{$randomInt}}",
          "species": "ferret"
        }
      },
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 201
        }
      ],
      "capture": {
        "petId": "body.id"
      }
    },
    {
      "id": "findsThePetJustAdded",
      "name": "Finds the pet just added",
      "trigger": "Request",
      "method": "GET",
      "path": "/pets/{{petId}}",
      "expect": [
        {
          "target": "status",
          "op": "equals",
          "value": 200
        },
        {
          "target": "body",
          "path": "species",
          "op": "equals",
          "value": "ferret"
        },
        {
          "target": "body",
          "path": "status",
          "op": "equals",
          "value": "available"
        }
      ]
    },
    {
      "id": "rejectsANonNumericId",
      "name": "Rejects an id that is not a number",
      "trigger": "Request",
      "method": "GET",
      "path": "/pets/rex",
      "expect": [
        {
          "target": "status",
          "op": "greaterThan",
          "value": 399
        }
      ]
    }
  ]
}
