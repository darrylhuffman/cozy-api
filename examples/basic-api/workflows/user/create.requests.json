{
  "lorien": 1,
  "requests": [
    {
      "id": "createsAUser",
      "name": "Creates a user",
      "trigger": "Request",
      "method": "POST",
      "path": "/users",
      "body": {
        "kind": "json",
        "json": {
          "email": "{{userPrefix}}-{{$randomInt}}@example.com",
          "password": "correct-horse"
        }
      },
      "expect": [
        { "target": "status", "op": "equals", "value": 200 },
        { "target": "body", "path": "id", "op": "type", "value": "string" },
        { "target": "body", "path": "email", "op": "matches", "value": "@example\\.com$" }
      ],
      "capture": { "userId": "body.id" }
    },
    {
      "id": "rejectsAnInvalidEmail",
      "name": "Rejects an invalid email",
      "trigger": "Request",
      "method": "POST",
      "path": "/users",
      "body": { "kind": "json", "json": { "email": "not-an-email", "password": "correct-horse" } },
      "expect": [{ "target": "status", "op": "greaterThan", "value": 399 }]
    }
  ]
}
